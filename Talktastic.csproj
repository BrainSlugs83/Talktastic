<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>say</AssemblyName>
    <RootNamespace>Talktastic</RootNamespace>
    <Version>0.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Talktastic</Product>
    <Description>Standalone Windows TTS CLI</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SpeechNativeResourceDirectory>$(MSBuildProjectDirectory)\native-resources</SpeechNativeResourceDirectory>
    <SpeechNativeRuntimeIdentifier>win-x64</SpeechNativeRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.Embedded.TTS" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.ONNX.Runtime" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.core.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.audio.sys.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.embedded.tts.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.onnxruntime.dll" />
  </ItemGroup>

  <Target Name="PrepareNativeResources" BeforeTargets="PrepareResourceNames" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-resources.ps1&quot; -OutputDirectory &quot;$(SpeechNativeResourceDirectory)&quot; -BasePackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech)&quot; -EmbeddedTtsPackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech_Extension_Embedded_TTS)&quot; -OnnxRuntimePackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech_Extension_ONNX_Runtime)&quot; -LamePackageDirectory &quot;$(PkgNAudio_Lame)&quot; -RuntimeIdentifier &quot;$(SpeechNativeRuntimeIdentifier)&quot;" />
    <ItemGroup>
      <GeneratedNativeResource Remove="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <GeneratedNativeResource Include="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <EmbeddedResource Remove="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <EmbeddedResource Remove="$(SpeechNativeResourceDirectory)\manifest.json" />
      <EmbeddedResource Include="@(GeneratedNativeResource)">
        <LogicalName>Talktastic.Native.%(GeneratedNativeResource.Filename)%(GeneratedNativeResource.Extension)</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SpeechNativeResourceDirectory)\manifest.json">
        <LogicalName>Talktastic.Native.manifest.json</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SpeechNativeResourceDirectory)\piper-runtime.zip" Condition="Exists('$(SpeechNativeResourceDirectory)\piper-runtime.zip')">
        <LogicalName>Talktastic.Piper.piper-runtime.zip</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="ExcludeEmbeddedSpeechNativeFilesFromPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <EmbeddedSpeechNativePublishCandidate Include="@(ResolvedFileToPublish)" Condition="&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.core.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.audio.sys.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.codec.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.embedded.tts.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.kws.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.kws.ort.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.onnxruntime.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.telemetry.dll'" />
      <ResolvedFileToPublish Remove="@(EmbeddedSpeechNativePublishCandidate)" />
    </ItemGroup>
  </Target>

  <Target Name="CleanNativeResources" AfterTargets="Clean">
    <RemoveDir Directories="$(SpeechNativeResourceDirectory)" />
  </Target>

</Project>
