<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>say</AssemblyName>
    <RootNamespace>Talktastic</RootNamespace>
    <Version>0.5.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Talktastic</Product>
    <Description>Standalone Windows TTS CLI</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SpeechNativeResourceDirectory>$(MSBuildProjectDirectory)\native-resources</SpeechNativeResourceDirectory>
    <SpeechNativeRuntimeIdentifier>win-x64</SpeechNativeRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NativeDebug>false</NativeDebug>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <PackageReference Include="BetterStringExtensions" Version="1.0.4" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.Embedded.TTS" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.ONNX.Runtime" Version="1.50.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.2" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.2" GeneratePathProperty="true" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Talktastic.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.core.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.audio.sys.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.embedded.tts.dll" />
    <EmbeddedSpeechNativePublishFile Include="Microsoft.CognitiveServices.Speech.extension.onnxruntime.dll" />
  </ItemGroup>

  <Target Name="PrepareNativeResources" BeforeTargets="PrepareResourceNames" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-resources.ps1&quot; -OutputDirectory &quot;$(SpeechNativeResourceDirectory)&quot; -BasePackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech)&quot; -EmbeddedTtsPackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech_Extension_Embedded_TTS)&quot; -OnnxRuntimePackageDirectory &quot;$(PkgMicrosoft_CognitiveServices_Speech_Extension_ONNX_Runtime)&quot; -LamePackageDirectory &quot;$(PkgNAudio_Lame)&quot; -SherpaOnnxPackageDirectory &quot;$(Pkgorg_k2fsa_sherpa_onnx_runtime_win-x64)&quot; -DmlOnnxRuntimePackageDirectory &quot;$(PkgMicrosoft_ML_OnnxRuntime_DirectML)&quot; -RuntimeIdentifier &quot;$(SpeechNativeRuntimeIdentifier)&quot;" />
    <ItemGroup>
      <GeneratedNativeResource Remove="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <GeneratedNativeResource Include="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <EmbeddedResource Remove="$(SpeechNativeResourceDirectory)\*.dll.gz" />
      <EmbeddedResource Remove="$(SpeechNativeResourceDirectory)\manifest.json" />
      <EmbeddedResource Include="@(GeneratedNativeResource)">
        <LogicalName>Talktastic.Native.%(GeneratedNativeResource.Filename)%(GeneratedNativeResource.Extension)</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SpeechNativeResourceDirectory)\manifest.json">
        <LogicalName>Talktastic.Native.manifest.json</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SpeechNativeResourceDirectory)\espeak-ng-data.zip" Condition="Exists('$(SpeechNativeResourceDirectory)\espeak-ng-data.zip')">
        <LogicalName>Talktastic.Piper.espeak-ng-data.zip</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Remove="$(SpeechNativeResourceDirectory)\skeleton_v2_*.gz" />
      <SkeletonResource Include="$(SpeechNativeResourceDirectory)\skeleton_v2_*.gz" />
      <EmbeddedResource Include="@(SkeletonResource)">
        <LogicalName>Talktastic.Rvc.%(SkeletonResource.Filename)%(SkeletonResource.Extension)</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="ExcludeEmbeddedSpeechNativeFilesFromPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <EmbeddedSpeechNativePublishCandidate Include="@(ResolvedFileToPublish)" Condition="&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.core.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.audio.sys.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.codec.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.embedded.tts.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.kws.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.kws.ort.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.onnxruntime.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.CognitiveServices.Speech.extension.telemetry.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.dll' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.lib' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.lib' Or&#xD;&#xA;          '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'sherpa-onnx-c-api.dll'" />
      <ResolvedFileToPublish Remove="@(EmbeddedSpeechNativePublishCandidate)" />
    </ItemGroup>
  </Target>

  <!-- Also exclude ORT native assets that come via NativeLibrary items (NativeAOT) -->
  <Target Name="ExcludeOrtNativeLibraries" BeforeTargets="_ComputeAssembliesToPostprocessOnPublish;ComputeLinkedFilesToPublish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <NativeBinary Remove="@(NativeBinary)" Condition="$([System.String]::new('%(Filename)').StartsWith('onnxruntime')) Or $([System.String]::new('%(Filename)').StartsWith('sherpa-onnx'))" />
    </ItemGroup>
  </Target>

  <Target Name="CleanNativeResources" AfterTargets="Clean">
    <RemoveDir Directories="$(SpeechNativeResourceDirectory)" />
  </Target>

  <!-- NativeAOT always generates a PDB even with DebugType=none; remove it post-link -->
  <Target Name="RemoveNativeAotPdb" AfterTargets="LinkNative" Condition="'$(PublishAot)' == 'true'">
    <Delete Files="$(NativeOutputPath)$(TargetName).pdb" />
    <Delete Files="$(PublishDir)$(TargetName).pdb" />
  </Target>

</Project>
