<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<ExcludeByFile>**/RegexGenerator.g.cs,**/*JsonContext*.g.cs,**/LibraryImports.g.cs</ExcludeByFile>
					<ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
