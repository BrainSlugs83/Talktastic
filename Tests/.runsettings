<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Include>[say]*</Include>
					<Exclude>[Talktastic.Tests]*,[xunit.*]*,[Microsoft.*]*</Exclude>
					<ExcludeByFile>**/Program.cs,**/RegexGenerator.g.cs,**/*JsonContext*.g.cs,**/LibraryImports.g.cs</ExcludeByFile>
					<ExcludeByAttribute>ExcludeFromCodeCoverageAttribute,GeneratedCodeAttribute</ExcludeByAttribute>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
